# Copy to .env and fill in. Never commit .env.

DJANGO_DEBUG=true
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Dhaka

# PostgreSQL connection. Leave empty to use SQLite (backend/db.sqlite3) in development.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
# true only behind a transaction pooler (e.g. Supabase port 6543).
DATABASE_TRANSACTION_POOLER=false
# Seconds to keep a database connection open. Leave 0 with runserver or a transaction pooler.
DATABASE_CONN_MAX_AGE=0

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Signs login tokens. Must be the SAME value as JWT_SIGNING_KEY in frontend/.env.local.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=

# Public address of the Next.js app, used in the receipt links customers open.
FRONTEND_URL=http://localhost:3000

# Production only:
# DJANGO_SECURE_SSL_REDIRECT=true
# CSRF_TRUSTED_ORIGINS=https://app.example.com
